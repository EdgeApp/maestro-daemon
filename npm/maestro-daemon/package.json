{
  "name": "maestro-daemon",
  "version": "0.1.0",
  "description": "Run Maestro YAML commands one at a time from JavaScript or the shell, on real devices, simulators and emulators. A fork of maestro-runner 1.1.26 with a persistent daemon.",
  "keywords": [
    "maestro",
    "maestro-runner",
    "mobile-testing",
    "e2e",
    "android",
    "ios",
    "react-native",
    "ui-testing",
    "daemon"
  ],
  "homepage": "https://github.com/EdgeApp/maestro-daemon#readme",
  "bugs": "https://github.com/EdgeApp/maestro-daemon/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgeApp/maestro-daemon.git",
    "directory": "npm/maestro-daemon"
  },
  "license": "Apache-2.0",
  "author": "Edge (https://edge.app)",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "maestro-daemon": "bin/maestro-daemon.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "maestro-daemon-darwin-arm64": "0.1.0",
    "maestro-daemon-darwin-x64": "0.1.0",
    "maestro-daemon-linux-arm64": "0.1.0",
    "maestro-daemon-linux-x64": "0.1.0"
  }
}
